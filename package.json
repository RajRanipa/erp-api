{
  "name": "orient-erp-api",
  "version": "1.0.0",
  "description": "Backend API for Orient Fibertech ERP",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch ./ --ext js,json,env --ignore node_modules server.js",
    "debug": "node --inspect server.js",
    "debug:break": "node --inspect-brk server.js",
    "test": "node --test",
    "audit:inventory": "node scripts/migrateInventoryItemMetadata.js",
    "migrate:inventory-items": "node scripts/migrateInventoryItemMetadata.js --apply",
    "audit:item-module-data": "node scripts/migrateItemModule.js",
    "migrate:item-module": "node scripts/migrateItemModule.js --apply",
    "audit:item-architecture-v2": "node scripts/migrateItemArchitectureV2.js",
    "migrate:item-architecture-v2": "node scripts/migrateItemArchitectureV2.js --apply",
    "audit:runtime-references-v2": "node scripts/migrateRuntimeReferencesV2.js",
    "migrate:runtime-references-v2": "node scripts/migrateRuntimeReferencesV2.js --apply",
    "audit:packing-uom-v2": "node scripts/migratePackingUomV2.js",
    "migrate:packing-uom-v2": "node scripts/migratePackingUomV2.js --apply",
    "audit:serial-traceability": "node scripts/migrateSerialTraceability.js",
    "migrate:serial-traceability": "node scripts/migrateSerialTraceability.js --apply",
    "serials:backfill": "node scripts/importSerialBackfill.js",
    "audit:inventory-architecture-v2": "node scripts/migrateInventoryArchitectureV2.js",
    "migrate:inventory-architecture-v2": "node scripts/migrateInventoryArchitectureV2.js --apply",
    "audit:party-module": "node scripts/migratePartyModule.js",
    "migrate:party-module": "node scripts/migratePartyModule.js --apply",
    "sync:permissions": "node scripts/syncPermissionCatalog.js",
    "audit:user-module": "node scripts/migrateUserModule.js",
    "migrate:user-module": "node scripts/migrateUserModule.js --apply",
    "audit:procurement-module": "node scripts/migrateProcurementModule.js",
    "migrate:procurement-module": "node scripts/migrateProcurementModule.js --apply",
    "audit:gateway-module": "node scripts/migrateGatewayModule.js",
    "audit:gateway-inventory": "node scripts/auditGatewayInventory.js",
    "migrate:gateway-module": "node scripts/migrateGatewayModule.js --apply",
    "audit:legacy-retirement": "node scripts/retireLegacyArchitecture.js",
    "retire:legacy-architecture": "node scripts/retireLegacyArchitecture.js --apply"
  },
  "keywords": [],
  "author": "Raj",
  "license": "MIT",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "bcrypt": "^6.0.0",
    "chalk": "^5.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "googleapis": "^173.0.0",
    "imapflow": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "mailparser": "^3.9.0",
    "mongoose": "^8.19.1",
    "multer": "^2.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.13",
    "puppeteer": "^25.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
